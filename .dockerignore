# Без этого файла `COPY . /app` затирает node_modules, который только что
# поставил `npm ci`, и тянет в контекст сборки .env-файлы и историю git.
# В CI каталога node_modules нет, поэтому там это не ломалось, — но при локальной
# сборке образа ломалось, а контекст раздувался до сотен мегабайт.

node_modules
dist
dist-ssr

.git
.github

# Секреты и локальные настройки: значения приходят через build args
.env
.env.*
*.local

# Локальные инструменты разработки (скриншоты адаптива)
scripts

.vscode
.idea
.DS_Store
*.log
